{
  "name": "host-wars",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "HOST WARS — a real-time strategy game inside the human body",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && node tools/check-assets.mjs && vitest run",
    "check:assets": "node tools/check-assets.mjs",
    "assets": "python3 -I tools/assets/process.py ../host-wars-raw public/assets"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
